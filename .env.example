# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
PROJECT_NAME="AI Resume Screening Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Postgres ---
# 5433 on the host so the container never clashes with a locally installed
# Postgres on 5432. Inside docker-compose the service still talks on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_screening

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
MAX_BULK_UPLOAD_FILES=50

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (Day 2 structured extraction) ---
# Free key: console.groq.com -> API Keys. Parsing is skipped (not failed) if unset.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PARSE_ON_UPLOAD=true

# --- Embeddings (Day 4 semantic matching) ---
# Runs locally via sentence-transformers — no API key needed. First run
# downloads the model (~130MB) from Hugging Face; the Docker image pre-downloads
# it at build time instead.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
WARM_UP_EMBEDDING_MODEL=true
